# Security + caching headers for RECHO (Cloudflare Pages)
#
# The site is 100% static (no Pages Functions), so this file applies to every
# response — it is the single source of truth for headers, including the
# Content-Security-Policy below. The old Cloudflare dashboard Transform Rule
# that used to set the CSP must stay DELETED: two sources would send two CSP
# headers and browsers enforce the intersection, breaking GTM/GA4/HubSpot.
#
# X-Robots-Tag is deliberately absent: a site-wide "index, follow" header
# would fight the noindex meta on the ads landing pages and /thank-you.
# Per-page <meta name="robots"> governs indexing alone.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Fresh-by-default: the sitemap uses clean URLs (/services, /blog/...)
  # which a /*.html rule never matches, so HTML freshness must be the base
  # rule; the asset blocks below override it with long immutable caches.
  Cache-Control: public, max-age=0, must-revalidate
  # CSP: allows GTM + GA4 + Google Ads (conversion/remarketing/linker),
  # the HubSpot tracking suite (loaded via GTM), Formspree, Tailwind CDN,
  # Google Fonts, and Font Awesome (jsdelivr/cdnjs). img-src https: covers
  # all tracking pixels. No report-uri/report-to — violation reports must
  # never point at this zone (request volume). Any NEW third-party domain
  # added via a GTM Custom HTML tag needs an allowance here first.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://formspree.io https://js.hs-scripts.com https://js.hs-analytics.net https://js.hs-banner.com https://js.hsadspixel.net https://js.hscollectedforms.net https://js.usemessages.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://*.googletagmanager.com https://www.google.com https://pagead2.googlesyndication.com https://track.hubspot.com https://forms.hubspot.com https://forms.hscollectedforms.net https://api.hubapi.com https://api.hsforms.com; frame-src 'self' https://formspree.io https://www.googletagmanager.com https://td.doubleclick.net https://bid.g.doubleclick.net https://www.google.com https://forms.hubspot.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io

# Long immutable cache for static assets (?v= query busts on change —
# bump it whenever a /js/* file is edited, e.g. utm-tracking.js?v=3)
/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
