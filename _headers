# Security Headers for RECHO Website
# These headers improve security posture and help pass enterprise security scans

/*
  # Prevent clickjacking attacks
  X-Frame-Options: DENY
  
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # Enable XSS protection
  X-XSS-Protection: 1; mode=block
  
  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Disable unnecessary features
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  
  # Strict Transport Security (HTTPS only)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Content Security Policy - Allow trusted sources only
  
  # Indicate this is a legitimate business website
  X-Robots-Tag: index, follow
  
  # Cache control for static assets
  Cache-Control: public, max-age=3600

# Specific headers for static assets (longer cache)
/images/*
  Cache-Control: public, max-age=31536000, immutable
  
/css/*
  Cache-Control: public, max-age=31536000, immutable
  
/js/*
  Cache-Control: public, max-age=31536000, immutable
  
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# No cache for HTML pages (ensure fresh content)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
